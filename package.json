{
  "name": "mcp-seo-audit-server",
  "version": "1.0.0",
  "description": "MCP server for comprehensive SEO audits - PageSpeed, Technical SEO, Sitemap/Robots, On-Page SEO, Security Headers, Mobile-Friendliness. Zero config required.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-seo-audit-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "pagespeed",
    "core-web-vitals",
    "technical-seo",
    "sitemap",
    "robots-txt",
    "security-headers",
    "on-page-seo",
    "mobile-friendly",
    "claude",
    "ai"
  ],
  "author": "Sofian Bettayeb <sofianbettayeb@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.0.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sofianbettayeb/mcp-seo-audit-server.git"
  },
  "bugs": {
    "url": "https://github.com/sofianbettayeb/mcp-seo-audit-server/issues"
  },
  "homepage": "https://github.com/sofianbettayeb/mcp-seo-audit-server#readme"
}
